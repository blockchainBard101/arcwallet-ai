# ==========================================
# ArcWallet AI - NestJS Backend Configuration
# ==========================================

# 🌐 Environment & Port
NODE_ENV=development
PORT=3001

# 🗄️ Database Setup (PostgreSQL)
# For Prisma connection: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arcwallet_ai?schema=public"

# 🔑 Privy Authentication
# Retrieved from your Privy Developer Dashboard (https://dashboard.privy.io)
PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET="your-privy-app-secret"
PRIVY_VERIFICATION_KEY="your-privy-verification-key" # Optional: For checking signatures locally

# 🤖 LLM Engine Settings
# Select your active provider: "anthropic" | "openai"
LLM_PROVIDER="anthropic"

# Anthropic API credentials (if using Claude 3.5 Sonnet)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# OpenAI API credentials (if using GPT-4o / GPT-4)
OPENAI_API_KEY="your-openai-api-key"

# 🔵 Circle CLI / Wallets Stack
# Circle API key for managing developer/user-controlled wallets
CIRCLE_API_KEY="your-circle-api-key"

# The EVM Chain used by default for the Circle Agent Wallet
# Set to "BASE" or "ARC_TESTNET" (Chain ID: 5042002)
DEFAULT_CHAIN="ARC_TESTNET"
ARC_TESTNET_RPC_URL="https://rpc.arc.circle.com" # Placeholders for customized Arc RPC URL
