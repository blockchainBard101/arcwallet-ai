// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 👤 User Entity (Linked to Privy Auth Identity)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  wallets      Wallet[]
  agents       Agent[]
  alerts       Alert[]
  chatSessions ChatSession[]
  subscription Subscription?
  apiKeys      ApiKey[]

  @@map("users")
}

// 📦 Subscription & Billing
model Subscription {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  tier             String   @default("free")  // "free" | "pro" | "power" | "enterprise"
  llmCallsUsed     Int      @default(0) @map("llm_calls_used")
  nanopayUsed      Float    @default(0) @map("nanopay_used")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// 💳 Wallets (Supports both Human Signer Wallet and Autonomous Agent Wallet)
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  address   String   @unique
  type      String   // "human" | "agent"
  chain     String   @default("arc")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents    Agent[]  @relation("AgentExecutionWallet")

  @@index([userId])
  @@map("wallets")
}

// 🤖 Personal AI Agents (Linked to Circle Agent Wallets)
model Agent {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  walletId      String   @map("wallet_id")
  name          String
  status        String   @default("active") // "active" | "paused" | "terminal"
  configuration Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet           @relation("AgentExecutionWallet", fields: [walletId], references: [id], onDelete: Cascade)
  rules         Rule[]
  activityLogs  ActivityLog[]
  chatSessions  ChatSession[]
  nanopaymentLogs NanopaymentLog[]
  yieldDeposits   YieldDeposit[]

  @@index([userId])
  @@index([walletId])
  @@map("agents")
}

// 📜 Automation Rules (Natural Language parsed triggers)
model Rule {
  id               String   @id @default(uuid())
  agentId          String   @map("agent_id")
  naturalRuleText  String   @map("natural_rule_text")
  parsedConditions Json     @map("parsed_conditions")
  status           String   @default("active") // "active" | "inactive"
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("rules")
}

// 🔔 Alerts & Notifications (Monitoring criteria)
model Alert {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // "balance" | "volume" | "custom"
  condition Json
  status    String   @default("pending") // "pending" | "triggered" | "dismissed"
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

// 📊 Audit Logs (Comprehensive transaction logs and rule evaluation outcomes)
model ActivityLog {
  id         String   @id @default(uuid())
  agentId    String   @map("agent_id")
  actionType String   @map("action_type") // "swap" | "transfer" | "rule_trigger" | "error"
  status     String   // "success" | "failed" | "pending_signature"
  txHash     String?  @map("tx_hash")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("activity_logs")
}

// 💬 Chat Sessions (One session per agent per user conversation thread)
model ChatSession {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  agentId   String?       @map("agent_id")
  createdAt DateTime      @default(now()) @map("created_at")

  // Relations
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]

  @@map("chat_sessions")
}

// 📨 Chat Messages (Rolling 20-message window stored per session)
model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  role      String      // "user" | "assistant" | "tool_result"
  content   String
  toolName  String?     @map("tool_name")
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// 💸 Nanopayment Logs (x402 paid API call history per agent)
model NanopaymentLog {
  id              String   @id @default(uuid())
  agentId         String   @map("agent_id")
  serviceUrl      String   @map("service_url")
  serviceName     String   @default("unknown") @map("service_name")
  chain           String   @default("BASE")
  amountUsdc      Float    @map("amount_usdc")
  status          String   @default("success") // "success" | "failed"
  responseSnippet String?  @map("response_snippet")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("nanopayment_logs")
}

// 🌾 Yield Deposits (DeFi Commission Tracking)
model YieldDeposit {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  agentId         String   @map("agent_id")
  protocol        String   // e.g., "ArcLend"
  poolName        String   @map("pool_name")
  amountUsdc      Float    @map("amount_usdc")
  txHash          String?  @map("tx_hash")
  commissionRate  Float    @default(0.10) @map("commission_rate") // 10% of yield
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([userId])
  @@map("yield_deposits")
}

// 🏢 Enterprise API Keys
model ApiKey {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  keyHash     String    @unique @map("key_hash")  // SHA-256 of the raw key
  name        String    // e.g., "My Integration"
  tier        String    @default("enterprise")
  callCount   Int       @default(0) @map("call_count")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}
